# copy to .env and fill in. never commit .env.

# public domain; core serves api.<domain>
DOMAIN=example.com
# shared secret trap uses on POST /ingest
INGEST_TOKEN=
# salt for ip_hash (salted sha256 of the attacker ip)
IP_HASH_SALT=

# llm used by the fake shell fallback and brain: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ip reputation lookups in brain
SERPAPI_KEY=

# tiger data (timescale postgres) connection string
TIGER_DATABASE_URL=
# local dev. on core, infra/core/docker-compose.yml builds it from REDIS_PASSWORD
REDIS_URL=redis://localhost:6379/0
# redis password on core. make one with: openssl rand -hex 32
REDIS_PASSWORD=
# maxmind geolite2 city database file (local dev; core mounts GEOIP_HOST_DIR at /data)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
# maxmind geolite2 asn database file (network owner, used by brain)
GEOIP_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
# folder on core that holds GeoLite2-City.mmdb and GeoLite2-ASN.mmdb
GEOIP_HOST_DIR=/opt/geoip

# where trap sends events, e.g. https://api.example.com
CORE_URL=https://api.example.com

# demo logins that mark a session as guest or team
GUEST_SSH_USER=guest
GUEST_SSH_PASSWORD=
TEAM_SSH_USER=team
TEAM_SSH_PASSWORD=
# comma separated ips that count as team
TEAM_IPS=

# public hostname or ip of the trap server
TRAP_HOST=

# trap ssh server. 2222 locally, 22 on the trap box
TRAP_SSH_HOST=0.0.0.0
TRAP_SSH_PORT=2222
# trap fake website. 8080 locally, 80 on the trap box
TRAP_HTTP_PORT=8080
# host keys and the event spool live here
TRAP_STATE_DIR=./state
# allowed default logins; empty means honeypot/data/logins.json
TRAP_LOGINS_PATH=
# session limits, in seconds where it's a time
TRAP_MAX_CONNECTIONS=200
TRAP_MAX_SESSIONS_PER_CONN=10
TRAP_LOGIN_TIMEOUT=60
TRAP_IDLE_TIMEOUT=300
TRAP_HARD_TIMEOUT=1800

# spend caps per hour. trap and brain each count their own llm calls against LLM_HOURLY_CAP
LLM_HOURLY_CAP=200
# part of brain's LLM_HOURLY_CAP held back from wild traffic for guest and team stories
LLM_RESERVED_HOURLY=40
SERPAPI_HOURLY_CAP=50

# our table at hacktx, used as geo for guest and team sessions
TABLE_LAT=30.29
TABLE_LON=-97.74

# backend ingest limits (per client ip)
INGEST_RATE_PER_SEC=20
INGEST_BURST=40
INGEST_MAX_BATCH=500
# brain worker
# redis consumer name inside the "brain" group on stream "raw"
BRAIN_CONSUMER=brain-1
# models brain uses for dossiers and stories
BRAIN_ANTHROPIC_MODEL=claude-haiku-5-5
BRAIN_GEMINI_MODEL=gemini-2.5-flash
# how long per-session state lives in redis
BRAIN_SESSION_TTL_S=86400
