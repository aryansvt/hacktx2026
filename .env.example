# copy to .env and fill in. never commit .env.

# public domain; core serves api.<domain>
DOMAIN=example.com
# shared secret trap uses on POST /ingest
INGEST_TOKEN=
# salt for ip_hash (salted sha256 of the attacker ip)
IP_HASH_SALT=

# llm used by the fake shell fallback and brain: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ip reputation lookups in brain
SERPAPI_KEY=

# tiger data (timescale postgres) connection string
TIGER_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# maxmind geolite2 city database file
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# where trap sends events, e.g. https://api.example.com
CORE_URL=https://api.example.com

# demo logins that mark a session as guest or team
GUEST_SSH_USER=guest
GUEST_SSH_PASSWORD=
TEAM_SSH_USER=team
TEAM_SSH_PASSWORD=
# comma separated ips that count as team
TEAM_IPS=

# public hostname or ip of the trap server
TRAP_HOST=

# trap ssh server. 2222 locally, 22 on the trap box
TRAP_SSH_HOST=0.0.0.0
TRAP_SSH_PORT=2222
# host keys and the event spool live here
TRAP_STATE_DIR=./state
# allowed default logins; empty means honeypot/data/logins.json
TRAP_LOGINS_PATH=
# session limits, in seconds where it's a time
TRAP_MAX_CONNECTIONS=200
TRAP_MAX_SESSIONS_PER_CONN=10
TRAP_LOGIN_TIMEOUT=60
TRAP_IDLE_TIMEOUT=300
TRAP_HARD_TIMEOUT=1800

# spend caps per hour
LLM_HOURLY_CAP=200
SERPAPI_HOURLY_CAP=50

# our table at hacktx, used as geo for guest and team sessions
TABLE_LAT=30.29
TABLE_LON=-97.74
