# copy to .env and fill in what you need. never commit .env.
# docker-compose.yml (the local stack) reads this file and has a safe local
# default for everything, so an empty .env works.

# ---- shared ----------------------------------------------------------------

# shared secret the trap sends on POST /ingest (Authorization: Bearer ...).
# make one with: openssl rand -hex 32
INGEST_TOKEN=
# salt for ip_hash, the salted sha256 of a visitor's ip. brain refuses to start without it.
# make one with: openssl rand -hex 32
IP_HASH_SALT=

# ---- llm and reputation (all optional) ------------------------------------
# without a key the trap answers with its rules engine only and brain writes
# template stories. without SERPAPI_KEY there are no dossiers.

# anthropic | gemini, for brain's dossiers and stories
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# models brain uses
BRAIN_ANTHROPIC_MODEL=claude-haiku-5-5
BRAIN_GEMINI_MODEL=gemini-2.5-flash
# google search via serpapi, for ip and indicator reputation
SERPAPI_KEY=
# spend caps per hour. trap and brain each count their own llm calls
LLM_HOURLY_CAP=200
# part of brain's LLM_HOURLY_CAP held back from wild traffic for guest and team stories
LLM_RESERVED_HOURLY=40
SERPAPI_HOURLY_CAP=50

# ---- core: backend and brain ----------------------------------------------

# timescale postgres connection string (we used tiger data). the local stack sets its own
TIGER_DATABASE_URL=
# a throwaway database for backend's integration tests (tests skip without it)
TEST_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# redis password, production core only (infra/core/docker-compose.yml)
REDIS_PASSWORD=
# public domain; production core serves api.<domain> and allows cors from it
DOMAIN=example.com
# backend ingest limits, per client ip
INGEST_RATE_PER_SEC=20
INGEST_BURST=40
INGEST_MAX_BATCH=500
# maxmind geolite2 files (optional; without them brain can't place visitors on the map)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
# production core mounts this host folder at /data for the two files above
GEOIP_HOST_DIR=/opt/geoip
# where guest and team sessions show up on the map (the venue, not a person)
TABLE_LAT=30.29
TABLE_LON=-97.74
# redis consumer name inside the "brain" group on stream "raw"
BRAIN_CONSUMER=brain-1
# how long per-session state lives in redis, in seconds
BRAIN_SESSION_TTL_S=86400
# brain log level
LOG_LEVEL=INFO

# ---- trap -------------------------------------------------------------------

# where the trap sends events, e.g. https://api.example.com. unset turns the sender off
CORE_URL=
# demo logins that mark a session as guest or team (both user and password needed)
GUEST_SSH_USER=guest
GUEST_SSH_PASSWORD=
TEAM_SSH_USER=team
TEAM_SSH_PASSWORD=
# comma separated ips that count as team
TEAM_IPS=
# the trap's address, the only target scripts/sim will ever talk to
TRAP_HOST=
# ssh server. 2222 when run directly, 22 inside the container
TRAP_SSH_HOST=0.0.0.0
TRAP_SSH_PORT=2222
# fake website. 8080 when run directly, 80 inside the container
TRAP_HTTP_PORT=8080
# host keys and the event spool live here
TRAP_STATE_DIR=./state
# allowed default logins; empty means honeypot/data/logins.json
TRAP_LOGINS_PATH=
# session limits, in seconds where it's a time
TRAP_MAX_CONNECTIONS=200
TRAP_MAX_SESSIONS_PER_CONN=10
TRAP_LOGIN_TIMEOUT=60
TRAP_IDLE_TIMEOUT=300
TRAP_HARD_TIMEOUT=1800

# ---- world (frontend) -----------------------------------------------------
# for npm run dev these go in world/.env.local (see world/.env.example).

# replay (default, the recorded snapshot) | live (needs a backend) | mock (fixtures)
NEXT_PUBLIC_MODE=replay
# live mode only
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/live
# older flag: 1 means mock when NEXT_PUBLIC_MODE is unset
NEXT_PUBLIC_MOCK=
# the local stack builds the world in this mode (live shows your local trap)
WORLD_MODE=live
