# copy to .env.local. every value here is public (NEXT_PUBLIC_ vars end up in the browser bundle)

# what the world shows:
#   replay  the anonymized recording in public/replay/snapshot.json, no backend needed (default)
#   live    a running backend at NEXT_PUBLIC_API_URL and NEXT_PUBLIC_WS_URL
#   mock    small built-in fixtures, handy for ui work
NEXT_PUBLIC_MODE=replay

# live mode only. these match the local stack in ../docker-compose.yml
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/live

# older flag, still honored when NEXT_PUBLIC_MODE is unset: 1 means mock
NEXT_PUBLIC_MOCK=
